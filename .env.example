NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local Playwright quality lab (configured once; never entered in /test.html)
PLAYWRIGHT_EMAIL=qa-user@example.com
PLAYWRIGHT_PASSWORD=your-qa-password
PLAYWRIGHT_BASE_URL=http://localhost:3000
TEST_RUNNER_ID=zunaid-local-runner
TEST_RUNNER_POLL_MS=2500

# AI reviewer
GEMINI_API_KEY=your-gemini-api-key
TEST_REVIEW_MODEL=gemini-3.6-flash
TEST_REVIEW_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
